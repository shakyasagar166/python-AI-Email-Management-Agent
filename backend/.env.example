# AI Email Management Agent - Environment Configuration
APP_NAME="MailMind AI Email Agent"
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./email_agent.db

# JWT & Security
SECRET_KEY=super-secret-mailmind-jwt-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
LLM_PROVIDER=mock # Options: mock, openai, anthropic, gemini
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_AI_MODEL=gpt-4o-mini
TEMPERATURE=0.3

# Gmail OAuth & IMAP (Optional for live sync)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
